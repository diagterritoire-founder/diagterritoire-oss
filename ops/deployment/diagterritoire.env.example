# MODELE : completer une copie hors Git avant utilisation.
# Destination : /etc/diagterritoire/diagterritoire.env
# Proprietaire root, groupe diagterritoire, permissions 0640.
# Format EnvironmentFile systemd : NOM=valeur, sans export.
# Aucun secret reel dans ce modele.

NODE_ENV=production
DATABASE_URL=
AUTH_SECRET=
AUTH_URL=https://collectivite.example.org

# Pour le reverse proxy Caddy controle.
# Next.js reste lie a 127.0.0.1.
AUTH_TRUST_HOST=true

DT_ALLOW_PILOT_SESSION=false
CODESPACES=false
DT_CODESPACES_RECIPE=false

BACKUP_DIR=/var/backups/diagterritoire
RETENTION_DAYS=7

# Injecter separement les secrets de provisionnement,
# uniquement pendant l'ouverture initiale des comptes.
