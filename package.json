{
  "name": "diagterritoire",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "runtime:check": "bash scripts/check-production-runtime.sh",
    "lint": "eslint",
    "db:check-pilot": "tsx scripts/check-dt-seed.ts",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate": "prisma migrate deploy",
    "db:seed-pilot": "tsx scripts/seed-pilot.ts",
    "db:init-pilot": "prisma generate && npm run db:migrate && npm run db:seed-pilot && npm run db:check-pilot"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "leaflet": "^1.9.4",
    "next": "16.3.4",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  },
  "license": "AGPL-3.0-only",
  "overrides": {
    "mysql2": "3.24.3",
    "deepmerge-ts": "8.0.2"
  }
}
