# Base de donnees
# Obligatoire hors du Dev Container de reference.
# Le Dev Container fournit automatiquement une URL PostgreSQL locale reelle.
DATABASE_URL=

# Auth.js
AUTH_SECRET=

# API publique
NEXT_PUBLIC_API_BASE_URL=

# Assistant territorial OmniRoute
OMNIROUTE_BASE_URL=
OMNIROUTE_MODEL=

# Session pilote - desactivee par defaut
DT_ALLOW_PILOT_SESSION=false
DT_PILOT_USER_ID=

# Comptes métier du pilote
# Utilisés uniquement par db:seed-pilot / db:init-pilot.
# Ne jamais stocker de mot de passe réel dans ce fichier.
DT_PILOT_CONTRIBUTOR_PASSWORD=
DT_PILOT_VALIDATOR_PASSWORD=
